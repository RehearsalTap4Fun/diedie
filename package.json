    "sfx": "node tools/build-sfx.mjs",
    "icons": "node tools/build-icons.mjs"
  },
  "dependencies": {
    "phaser": "^3.85.2",
    "poly-decomp": "^0.3.0"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
