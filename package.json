{
  "name": "diedie-china",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --mode web",
    "deploy": "npm run build:web && tools/deploy.sh",
    "preview": "vite preview --host",
